@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using PatinaBlazor.Services
@inject ICollectableService CollectableService
@inject ILogger<Home> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Welcome to Silzell.net</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <div class="text-center mb-8">
        <MudText Typo="Typo.h2" Color="Color.Primary" Class="mb-3" Style="font-weight:700;">Welcome to Silzell.net</MudText>
        <MudText Typo="Typo.h6" Color="Color.Secondary">You are here.</MudText>
    </div>
</MudContainer>

<footer class="page-footer">
    <HitCounter PagePath="/" />
</footer>


@code {
    private int itemsPerSlide = 3; // Number of items to show per carousel slide on desktop
    private int currentSlide = 0; // For desktop carousel
    private int currentMobileSlide = 0; // For mobile carousel

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true
            && authState.User.IsInRole("Storage Admin")
            && !authState.User.IsInRole("Admin"))
        {
            Navigation.NavigateTo("/storage/admin");
        }
    }
}