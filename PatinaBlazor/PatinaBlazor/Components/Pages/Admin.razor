@page "/admin"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudText Typo="Typo.h4" Class="mb-4">Admin Panel</MudText>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2">
                <MudToolBar Dense="true" Class="mud-theme-primary">
                    <MudText Typo="Typo.h6">System Statistics</MudText>
                </MudToolBar>
                <div class="pa-4">
                    <MudText Typo="Typo.body1" Class="mb-2"><strong>Total Users:</strong> 1,234</MudText>
                    <MudText Typo="Typo.body1" Class="mb-2"><strong>Active Sessions:</strong> 56</MudText>
                    <MudText Typo="Typo.body1" Class="mb-2"><strong>Database Size:</strong> 2.3 MB</MudText>
                    <MudText Typo="Typo.body1"><strong>Last Backup:</strong> 2025-01-08 10:30 AM</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2">
                <MudToolBar Dense="true" Class="mud-theme-primary">
                    <MudText Typo="Typo.h6">Quick Actions</MudText>
                </MudToolBar>
                <MudStack Spacing="2" Class="pa-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="/admin/allUsers">Users</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Href="/storage/admin">Storage Dashboard</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true">Clear Cache</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true">View Logs</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true">System Maintenance</MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mt-4">
        <MudItem xs="12">
            <MudPaper Elevation="2">
                <MudToolBar Dense="true" Class="mud-theme-primary">
                    <MudText Typo="Typo.h6">Recent Activity</MudText>
                </MudToolBar>
                <MudTable Items="_recentActivity" Hover="true" Dense="true" Class="pa-2">
                    <HeaderContent>
                        <MudTh>Time</MudTh>
                        <MudTh>User</MudTh>
                        <MudTh>Action</MudTh>
                        <MudTh>Status</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Time">@context.Time</MudTd>
                        <MudTd DataLabel="User">@context.User</MudTd>
                        <MudTd DataLabel="Action">@context.Action</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Color="@context.StatusColor" Size="Size.Small">@context.Status</MudChip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    // Mock data — not wired to real telemetry.
    private record ActivityRow(string Time, string User, string Action, string Status, Color StatusColor);

    private readonly List<ActivityRow> _recentActivity = new()
    {
        new("10:45 AM", "john.doe@example.com", "Login", "Success", Color.Success),
        new("10:32 AM", "jane.smith@example.com", "Password Reset", "Pending", Color.Warning),
        new("10:15 AM", "admin@example.com", "Database Backup", "Completed", Color.Success),
    };
}
