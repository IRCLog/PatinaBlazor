@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using PatinaBlazor.Data
@using PatinaBlazor.Services
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject IAdminDashboardService AdminDashboardService

<PageTitle>Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudText Typo="Typo.h4" Class="mb-6">Admin Panel</MudText>

    @if (_summary == null)
    {
        <div class="text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body1" Class="mt-2">Loading dashboard...</MudText>
        </div>
    }
    else
    {
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Total Users</MudText>
                    <MudText Typo="Typo.h4">@_summary.UserCount</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Collectables</MudText>
                    <MudText Typo="Typo.h4">@_summary.CollectableCount</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Published Articles</MudText>
                    <MudText Typo="Typo.h4">@_summary.PublishedArticleCount</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_summary.TotalArticleCount total</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Storage Occupancy</MudText>
                    <MudText Typo="Typo.h4">@_summary.Storage.OccupancyPercent.ToString("0.#")%</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_summary.Storage.OccupiedUnits of @_summary.Storage.TotalUnits units</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Storage MRR</MudText>
                    <MudText Typo="Typo.h4">@_summary.Storage.CurrentMrr.ToString("C0")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Errors (Last 24h)</MudText>
                    <MudText Typo="Typo.h4" Color="@(_summary.ErrorCount24h > 0 ? Color.Error : Color.Default)">@_summary.ErrorCount24h</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2">
                    <MudToolBar Dense="true" Class="mud-theme-primary">
                        <MudText Typo="Typo.h6">Quick Actions</MudText>
                    </MudToolBar>
                    <MudStack Spacing="2" Class="pa-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="/admin/allUsers" StartIcon="@Icons.Material.Filled.People">Users</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Href="/storage/admin" StartIcon="@Icons.Material.Filled.Warehouse">Storage Dashboard</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" FullWidth="true" Href="/articles/admin" StartIcon="@Icons.Material.Filled.EditNote">Manage Articles</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true" Href="/admin/logs" StartIcon="@Icons.Material.Filled.History">View Logs</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2">
                    <MudToolBar Dense="true" Class="mud-theme-primary">
                        <MudText Typo="Typo.h6">Recent Activity</MudText>
                    </MudToolBar>
                    @if (_summary.RecentActivity.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">No errors or security events recorded yet.</MudText>
                    }
                    else
                    {
                        <MudTable Items="_summary.RecentActivity" Hover="true" Dense="true" Class="pa-2">
                            <HeaderContent>
                                <MudTh>Time</MudTh>
                                <MudTh>Level</MudTh>
                                <MudTh>Message</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Time" Style="white-space: nowrap;">@context.TimeStampCentral.ToString("M/d h:mm tt")</MudTd>
                                <MudTd DataLabel="Level">
                                    <MudChip T="string" Color="@LevelColor(context.Level)" Size="Size.Small">@(context.EventCategory ?? context.Level)</MudChip>
                                </MudTd>
                                <MudTd DataLabel="Message" Style="max-width: 260px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@context.Message</MudTd>
                            </RowTemplate>
                        </MudTable>
                        <div class="pa-2">
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/admin/logs" FullWidth="true">View All Logs</MudButton>
                        </div>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private AdminDashboardSummary? _summary;

    protected override async Task OnInitializedAsync()
    {
        _summary = await AdminDashboardService.GetSummaryAsync();
    }

    private static Color LevelColor(string? level) => level switch
    {
        "Error" or "Fatal" => Color.Error,
        "Warning" => Color.Warning,
        _ => Color.Default
    };
}
