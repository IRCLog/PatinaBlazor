@page "/edit-collectable/{id:guid}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using PatinaBlazor.Data
@using PatinaBlazor.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@rendermode InteractiveServer
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IImageService ImageService
@inject ISnackbar Snackbar

<ImageModal @ref="imageModal" Description="@collectable?.Description" />

<PageTitle>Edit Collectable</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    @if (collectable == null)
    {
        <div class="text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body1" Class="mt-2">Loading collectable...</MudText>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
        <div class="text-center">
            <MudButton Variant="Variant.Filled" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/my-collectables">Back to My Collectables</MudButton>
        </div>
    }
    else
    {
        <div class="d-flex justify-space-between align-center mb-4">
            <MudText Typo="Typo.h4">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" /> Edit Collectable
            </MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.List" Href="/my-collectables">My Collectables</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/collectables">Back to Collectables</MudButton>
            </MudStack>
        </div>

        <MudPaper Elevation="2" Class="pa-4">
            <EditForm Model="@editModel" OnValidSubmit="@HandleValidSubmit" FormName="EditCollectableForm">
                <DataAnnotationsValidator />

                <MudTabs Rounded="true" Color="Color.Primary" Class="mb-4">
                    <MudTabPanel Text="General Information" Icon="@Icons.Material.Filled.Info">
                        <MudTextField Label="Description" Required="true" @bind-Value="editModel.Description" For="@(() => editModel.Description)" Placeholder="Enter description of your collectable" Class="mb-4" />
                        <MudNumericField Label="Price Paid (USD)" Required="true" @bind-Value="editModel.PricePaid" For="@(() => editModel.PricePaid)" Format="F2" Adornment="Adornment.Start" AdornmentText="$" Class="mb-4" />
                        <MudDatePicker Label="Date Acquired" @bind-Date="editModel.DateAcquired" For="@(() => editModel.DateAcquired)" Class="mb-4" />
                        <MudTextField Label="Acquired From" @bind-Value="editModel.AcquiredFrom" For="@(() => editModel.AcquiredFrom)" Placeholder="Where or who did you acquire this from?" Class="mb-4" />
                        <MudTextField Label="Notes" @bind-Value="editModel.Notes" For="@(() => editModel.Notes)" Placeholder="Add any additional notes about this collectable (optional)" Lines="4" Class="mb-4" />
                    </MudTabPanel>

                    <MudTabPanel Text="Sale Information" Icon="@Icons.Material.Filled.AttachMoney">
                        <MudSwitch T="bool" @bind-Value="editModel.IsForSale" Label="This item is for sale" Color="Color.Primary" Class="mb-3" />

                        @if (editModel.IsForSale)
                        {
                            <MudNumericField Label="Asking Price (USD)" @bind-Value="editModel.AskingPrice" For="@(() => editModel.AskingPrice)" Format="F2" Adornment="Adornment.Start" AdornmentText="$" Class="mb-4" />
                        }

                        <MudSwitch T="bool" @bind-Value="editModel.IsSold" Label="This item has been sold" Color="Color.Primary" Class="mb-3" />

                        @if (editModel.IsSold)
                        {
                            <MudNumericField Label="Sale Price (USD)" @bind-Value="editModel.SalePrice" For="@(() => editModel.SalePrice)" Format="F2" Adornment="Adornment.Start" AdornmentText="$" Class="mb-4" />
                            <MudDatePicker Label="Date Sold" @bind-Date="editModel.DateSold" For="@(() => editModel.DateSold)" Class="mb-4" />
                            <MudTextField Label="Sold To" @bind-Value="editModel.SoldTo" For="@(() => editModel.SoldTo)" Placeholder="Who did you sell this to?" Class="mb-4" />
                        }
                    </MudTabPanel>

                    <MudTabPanel Text="Images" Icon="@Icons.Material.Filled.Image">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Current Images</MudText>
                        @if (collectable.Images != null && collectable.Images.Any())
                        {
                            <MudGrid Class="mb-4">
                                @foreach (var image in collectable.Images.OrderBy(i => i.DisplayOrder))
                                {
                                    <MudItem xs="12" md="6">
                                        <MudCard>
                                            <div style="height: 200px; overflow: hidden; display: flex; align-items: center; justify-content: center; background-color: var(--bg-tertiary);">
                                                <img src="@image.MediumUrl"
                                                     alt="@collectable.Description"
                                                     style="max-height: 100%; max-width: 100%; object-fit: contain; cursor: pointer;"
                                                     @onclick="(() => ShowImageModal(image))" />
                                            </div>
                                            <MudCardContent>
                                                @if (image.IsMainImage)
                                                {
                                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mb-2">Main Image</MudChip>
                                                }
                                                <MudStack Row="true" Spacing="2">
                                                    @if (!image.IsMainImage)
                                                    {
                                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Star" OnClick="(() => SetAsMainImage(image))">Set as Main</MudButton>
                                                    }
                                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="(() => RemoveImage(image))">Remove</MudButton>
                                                </MudStack>
                                            </MudCardContent>
                                        </MudCard>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">No images currently set.</MudText>
                        }

                        <MudText Typo="Typo.subtitle2" Class="mb-2">Upload New Images</MudText>
                        <InputFile @ref="imagesInput" id="images" OnChange="OnImagesSelected" accept="image/*" multiple class="mud-input-file" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 mb-3" Style="display: block;">
                            Upload up to 10 new images for your collectable (max 15MB each). Supported formats: JPG, PNG, GIF, WebP. Large images will be automatically compressed to improve upload speed.
                        </MudText>

                        @if (imageUploadErrors.Any())
                        {
                            <MudAlert Severity="Severity.Error" Class="mt-2">
                                Image Upload Errors:
                                <ul class="mb-0 mt-2">
                                    @foreach (var error in imageUploadErrors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </MudAlert>
                        }

                        @if (selectedImageFiles.Any())
                        {
                            <div class="mt-3">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudText Typo="Typo.subtitle1">
                                        <MudIcon Icon="@Icons.Material.Filled.Image" Class="mr-1" /> New Images Selected (@selectedImageFiles.Count)
                                    </MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel" OnClick="ClearSelectedImages">Clear All</MudButton>
                                </div>
                                <MudGrid>
                                    @for (int i = 0; i < selectedImageFiles.Count; i++)
                                    {
                                        var index = i;
                                        var file = selectedImageFiles[i];
                                        <MudItem xs="12" md="6" lg="4">
                                            <MudCard>
                                                @if (index < imagePreviewUrls.Count)
                                                {
                                                    <div style="height: 200px; overflow: hidden; display: flex; align-items: center; justify-content: center; background-color: var(--bg-tertiary);">
                                                        <img src="@imagePreviewUrls[index]"
                                                             alt="@file.Name"
                                                             style="max-height: 100%; max-width: 100%; object-fit: contain; cursor: pointer;"
                                                             @onclick="(() => ShowSelectedImageModal(index))" />
                                                    </div>
                                                }
                                                <MudCardContent>
                                                    <MudText Typo="Typo.subtitle2">@file.Name</MudText>
                                                    <MudText Typo="Typo.body2">Size: @FormatFileSize(file.Size)</MudText>
                                                    <MudText Typo="Typo.body2" Class="mb-2">Type: @file.ContentType</MudText>
                                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel" OnClick="(() => RemoveSelectedImage(index))">Remove</MudButton>
                                                </MudCardContent>
                                            </MudCard>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </div>
                        }
                    </MudTabPanel>
                </MudTabs>

                <div class="d-flex justify-end" style="gap: 0.5rem;">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Cancel" Href="/my-collectables">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="@isSubmitting" StartIcon="@Icons.Material.Filled.Save">
                        @if (isSubmitting)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                        }
                        Update Collectable
                    </MudButton>
                </div>
            </EditForm>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }

    private Collectable? collectable;
    private CollectableEditModel editModel = new();
    private string currentUserId = string.Empty;
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;
    private List<IBrowserFile> selectedImageFiles = new();
    private List<string> imageUploadErrors = new();
    private ImageModal imageModal = default!;
    private InputFile? imagesInput;
    private List<string> imagePreviewUrls = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            currentUserId = user.Id;
            await LoadCollectable();
        }
    }

    private async Task LoadCollectable()
    {
        collectable = await DbContext.Collectables
            .Include(c => c.Images)
            .FirstOrDefaultAsync(c => c.Id == Id && c.UserId == currentUserId);

        if (collectable == null)
        {
            errorMessage = "Collectable not found or you don't have permission to edit it.";
            return;
        }

        // Populate the edit model
        editModel.Description = collectable.Description;
        editModel.PricePaid = collectable.PricePaid;
        editModel.AskingPrice = collectable.AskingPrice;
        editModel.DateAcquired = collectable.DateAcquired;
        editModel.AcquiredFrom = collectable.AcquiredFrom;
        editModel.IsForSale = collectable.IsForSale;
        editModel.IsSold = collectable.IsSold;
        editModel.DateSold = collectable.DateSold;
        editModel.SoldTo = collectable.SoldTo;
        editModel.SalePrice = collectable.SalePrice;
        editModel.Notes = collectable.Notes;
    }

    private async Task HandleValidSubmit()
    {
        if (collectable == null || string.IsNullOrEmpty(currentUserId))
        {
            Snackbar.Add("Invalid collectable or user session. Please refresh and try again.", Severity.Error);
            return;
        }

        isSubmitting = true;
        StateHasChanged();

        try
        {
            // Update basic properties
            collectable.Description = editModel.Description;
            collectable.PricePaid = editModel.PricePaid;
            collectable.AskingPrice = editModel.AskingPrice;
            collectable.DateAcquired = editModel.DateAcquired;
            collectable.AcquiredFrom = editModel.AcquiredFrom;
            collectable.IsForSale = editModel.IsForSale;
            collectable.IsSold = editModel.IsSold;
            collectable.DateSold = editModel.DateSold;
            collectable.SoldTo = editModel.SoldTo;
            collectable.SalePrice = editModel.SalePrice;
            collectable.Notes = editModel.Notes;

            // Handle multiple new image uploads if present
            if (selectedImageFiles.Any())
            {
                var uploadResults = await ImageService.SaveMultipleImagesAsync(selectedImageFiles, collectable.ImageSubfolder);

                var successfulUploads = uploadResults.Where(r => r.Success).ToList();
                var failedUploads = uploadResults.Where(r => !r.Success).ToList();

                if (failedUploads.Any())
                {
                    var errorMessage = string.Join(", ", failedUploads.Select(f => f.ErrorMessage));
                    Snackbar.Add($"Failed to upload some images: {errorMessage}", Severity.Error);

                    // Clean up successful uploads if any failed
                    foreach (var successResult in successfulUploads)
                    {
                        await ImageService.DeleteImageAsync(successResult);
                    }
                    return;
                }

                // Create ImageAttachment records for successful uploads
                var currentImageCount = collectable.Images.Count;
                for (int i = 0; i < successfulUploads.Count; i++)
                {
                    var result = successfulUploads[i];
                    var newImage = new ImageAttachment
                    {
                        CollectableId = collectable.Id,
                        FileName = result.FileName,
                        RelativePath = result.RelativePath,
                        ThumbnailRelativePath = result.ThumbnailRelativePath,
                        MediumRelativePath = result.MediumRelativePath,
                        ContentType = result.ContentType,
                        FileSize = result.FileSize,
                        IsMainImage = currentImageCount == 0 && i == 0, // First new image is main if no existing images
                        DisplayOrder = currentImageCount + i,
                        CreatedDate = DateTime.UtcNow
                    };

                    DbContext.ImageAttachments.Add(newImage);
                }
            }

            await DbContext.SaveChangesAsync();

            Snackbar.Add($"Successfully updated '{collectable.Description}'!", Severity.Success);

            // Navigate back after a short delay
            await Task.Delay(2000);
            Navigation.NavigateTo("/my-collectables");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to update collectable: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task SetAsMainImage(ImageAttachment image)
    {
        if (collectable?.Images != null)
        {
            // Remove main status from all images
            foreach (var img in collectable.Images)
            {
                img.IsMainImage = false;
            }

            // Set this image as main
            image.IsMainImage = true;

            // Update in database
            DbContext.ImageAttachments.UpdateRange(collectable.Images);
            await DbContext.SaveChangesAsync();

            StateHasChanged();
        }
    }

    private async Task RemoveImage(ImageAttachment image)
    {
        if (collectable?.Images != null)
        {
            // Delete the physical file
            await ImageService.DeleteImageAsync(image);

            // Remove from database
            DbContext.ImageAttachments.Remove(image);
            collectable.Images.Remove(image);

            // If this was the main image and there are other images, set the first one as main
            if (image.IsMainImage && collectable.Images.Any())
            {
                collectable.Images.First().IsMainImage = true;
            }

            await DbContext.SaveChangesAsync();
            StateHasChanged();
        }
    }

    private async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        selectedImageFiles.Clear();
        imageUploadErrors.Clear();
        await ClearImagePreviewUrls();

        if (e.FileCount > 0)
        {
            selectedImageFiles.AddRange(e.GetMultipleFiles());
            imageUploadErrors = ImageService.ValidateImageFiles(selectedImageFiles);
            await CreateImagePreviewUrls();
        }

        StateHasChanged();
    }

    private async Task ClearSelectedImages()
    {
        selectedImageFiles.Clear();
        imageUploadErrors.Clear();
        await ClearImagePreviewUrls();
        StateHasChanged();
    }

    private async Task RemoveSelectedImage(int index)
    {
        if (index >= 0 && index < selectedImageFiles.Count)
        {
            // Revoke the URL for the removed image
            if (index < imagePreviewUrls.Count)
            {
                await JSRuntime.InvokeVoidAsync("URL.revokeObjectURL", imagePreviewUrls[index]);
                imagePreviewUrls.RemoveAt(index);
            }

            selectedImageFiles.RemoveAt(index);
            imageUploadErrors = ImageService.ValidateImageFiles(selectedImageFiles);
            StateHasChanged();
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB" };
        int counter = 0;
        decimal number = bytes;

        while (Math.Round(number / 1024) >= 1)
        {
            number /= 1024;
            counter++;
        }

        return $"{number:n1}{suffixes[counter]}";
    }

    private async Task ShowImageModal(ImageAttachment selectedImage)
    {
        if (collectable?.Images != null && collectable.Images.Any())
        {
            var images = collectable.Images.OrderBy(i => i.DisplayOrder).ToList();
            var startIndex = images.FindIndex(i => i.Id == selectedImage.Id);
            await imageModal.ShowModal(images, Math.Max(0, startIndex));
        }
    }

    private async Task CreateImagePreviewUrls()
    {
        await ClearImagePreviewUrls();

        // Passing an IBrowserFile itself through JS interop only serializes its metadata, not a
        // real File/Blob - URL.createObjectURL needs the actual browser File object, which is only
        // reachable via the underlying <input> element's own .files list, indexed the same way
        // selectedImageFiles was just built from e.GetMultipleFiles() a moment ago in OnImagesSelected.
        if (imagesInput?.Element is { } inputElement)
        {
            for (var i = 0; i < selectedImageFiles.Count; i++)
            {
                var url = await JSRuntime.InvokeAsync<string>("createObjectURLFromInput", inputElement, i);
                imagePreviewUrls.Add(url);
            }
        }
    }

    private async Task ClearImagePreviewUrls()
    {
        foreach (var url in imagePreviewUrls)
        {
            await JSRuntime.InvokeVoidAsync("URL.revokeObjectURL", url);
        }
        imagePreviewUrls.Clear();
    }

    private async Task ShowSelectedImageModal(int index)
    {
        if (imagePreviewUrls.Count > index)
        {
            await imageModal.ShowModal(imagePreviewUrls, index);
        }
    }

    public class CollectableEditModel
    {
        [Required(ErrorMessage = "Description is required")]
        [StringLength(500, ErrorMessage = "Description cannot exceed 500 characters")]
        public string Description { get; set; } = string.Empty;

        [Required(ErrorMessage = "Price paid is required")]
        [Range(0.01, double.MaxValue, ErrorMessage = "Price paid must be greater than $0.00")]
        public decimal PricePaid { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "Asking price must be a positive value")]
        public decimal? AskingPrice { get; set; }

        public DateTime? DateAcquired { get; set; }

        [StringLength(200, ErrorMessage = "Acquired from cannot exceed 200 characters")]
        public string? AcquiredFrom { get; set; }

        public bool IsForSale { get; set; } = false;

        public bool IsSold { get; set; } = false;

        public DateTime? DateSold { get; set; }

        [StringLength(200, ErrorMessage = "Sold to cannot exceed 200 characters")]
        public string? SoldTo { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "Sale price must be a positive value")]
        public decimal? SalePrice { get; set; }

        [StringLength(1000, ErrorMessage = "Notes cannot exceed 1000 characters")]
        public string? Notes { get; set; }
    }
}

<script>
    window.createObjectURLFromInput = (inputElement, index) => {
        return URL.createObjectURL(inputElement.files[index]);
    };
</script>
