@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PatinaBlazor.Data
@using PatinaBlazor.Services
@using System.ComponentModel.DataAnnotations
@inject IArticleService ArticleService
@inject IImageService ImageService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<MudDialog @bind-Visible="_isVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEditMode ? "Edit Article" : "Add Article")</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="HandleSave" id="articleForm">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMessage</MudAlert>
            }

            <MudTextField Label="Title" @bind-Value="_model.Title" For="@(() => _model.Title)" Class="mb-4" />
            <MudTextField Label="Tag Line" @bind-Value="_model.TagLine" For="@(() => _model.TagLine)" Class="mb-4" />

            <MudAutocomplete T="ApplicationUser"
                              Label="Author"
                              @bind-Value="_selectedAuthor"
                              SearchFunc="SearchAuthorsAsync"
                              ToStringFunc="@(u => u == null ? "" : $"{(string.IsNullOrWhiteSpace(u.DisplayName) ? u.UserName : u.DisplayName)} ({u.Email})")"
                              Class="mb-6" />

            <MudGrid Class="mb-2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="ArticleStatus" Label="Status" @bind-Value="_model.Status">
                        <MudSelectItem Value="ArticleStatus.Draft">Draft</MudSelectItem>
                        <MudSelectItem Value="ArticleStatus.Published">Published</MudSelectItem>
                        <MudSelectItem Value="ArticleStatus.Archived">Archived</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="ArticleAudience" Label="Audience" @bind-Value="_model.Audience">
                        <MudSelectItem Value="ArticleAudience.Public">Public (anyone, including anonymous visitors)</MudSelectItem>
                        <MudSelectItem Value="ArticleAudience.RegisteredUsers">Registered Users</MudSelectItem>
                        <MudSelectItem Value="ArticleAudience.StorageCustomers">Storage Customers</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudSwitch T="bool" @bind-Value="_model.FeatureOnHomePage" Color="Color.Primary" Class="mb-4">
                Feature on Home page
            </MudSwitch>
            @if (_model.FeatureOnHomePage && _model.Audience != ArticleAudience.Public)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    Only Public articles are shown in the Home page's featured section - this article won't appear there until its audience is set to Public.
                </MudAlert>
            }

            <MudTextField Label="Body (Markdown)" @bind-Value="_model.Body" For="@(() => _model.Body)" Lines="14" Class="mb-4" />

            <MudSelect T="ArticleMediaLayout" Label="Media Layout" @bind-Value="_model.MediaLayout" Class="mb-1">
                <MudSelectItem Value="ArticleMediaLayout.Hero">Hero - big banner photo above the title</MudSelectItem>
                <MudSelectItem Value="ArticleMediaLayout.SplitTextWrap">Split - photo floats beside the opening text</MudSelectItem>
                <MudSelectItem Value="ArticleMediaLayout.Gallery">Gallery - every photo in a grid after the article</MudSelectItem>
                <MudSelectItem Value="ArticleMediaLayout.Masonry">Masonry - every photo in a staggered grid after the article</MudSelectItem>
                <MudSelectItem Value="ArticleMediaLayout.Carousel">Carousel - every photo as a slideshow after the article</MudSelectItem>
                <MudSelectItem Value="ArticleMediaLayout.InlineBreaks">Inline breaks - photos woven between paragraphs of the body</MudSelectItem>
            </MudSelect>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-6" Style="display: block;">
                @GetLayoutDescription(_model.MediaLayout)
            </MudText>

            <MudText Typo="Typo.subtitle2" Class="mb-2">Photos</MudText>
            <InputFile id="articleImages" OnChange="OnImagesSelected" accept="image/*" multiple class="mud-input-file" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 mb-6" Style="display: block;">
                Upload photos for the article (max 15MB each, JPG/PNG/GIF/WebP). Drag to reorder - order determines each photo's slot in the layout above, and the first photo is used as the article's thumbnail.
            </MudText>

            @if (_imageUploadErrors.Any())
            {
                <MudAlert Severity="Severity.Error" Class="mb-6">
                    <ul class="mb-0">
                        @foreach (var error in _imageUploadErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </MudAlert>
            }

            @if (_existingImageItems.Count >= 2)
            {
                <MudDropContainer T="ArticleImageDropItem"
                                  Items="_existingImageItems"
                                  ItemsSelector="@((item, zone) => true)"
                                  ItemDropped="ExistingImageDropped"
                                  Class="d-flex flex-wrap mb-2">
                    <ChildContent>
                        <MudDropZone T="ArticleImageDropItem" Identifier="Photos" Class="d-flex flex-wrap flex-grow-1" />
                    </ChildContent>
                    <ItemRenderer Context="photoItem">
                        @{ var slot = _existingImageItems.IndexOf(photoItem) + 1; }
                        <div style="position: relative; width: 110px; margin: 4px; cursor: grab;">
                            <ResponsiveImage Image="photoItem.Image" Height="80px" Sizes="33vw" BorderRadius="4px" />
                            <div style="position: absolute; top: 2px; left: 2px; background: var(--mud-palette-primary); color: white; border-radius: 50%; width: 20px; height: 20px; font-size: 12px; display: flex; align-items: center; justify-content: center;">@slot</div>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" Style="position: absolute; top: 0; right: 0;" OnClick="@(() => RemoveExistingImage(photoItem.Image))" />
                        </div>
                    </ItemRenderer>
                </MudDropContainer>
            }
            else if (_existingImageItems.Any())
            {
                <MudGrid Class="mb-2">
                    @foreach (var item in _existingImageItems)
                    {
                        <MudItem xs="4">
                            <div style="position: relative;">
                                <ResponsiveImage Image="item.Image" Height="80px" Sizes="33vw" BorderRadius="4px" />
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" Style="position: absolute; top: 0; right: 0;" OnClick="@(() => RemoveExistingImage(item.Image))" />
                            </div>
                        </MudItem>
                    }
                </MudGrid>
            }

            @if (_selectedImageFiles.Any())
            {
                <MudGrid Class="mb-2">
                    @foreach (var file in _selectedImageFiles)
                    {
                        <MudItem xs="4">
                            <MudPaper Class="pa-2" Style="height: 80px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                <MudText Typo="Typo.caption" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@file.Name</MudText>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Disabled="_isSaving">Cancel</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="articleForm" Variant="Variant.Filled" Color="Color.Primary" Disabled="_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseOnEscapeKey = true,
    };

    private bool _isVisible;
    private bool _isSaving;
    private bool _isEditMode;
    private string? _errorMessage;

    private Article? _article;
    private ArticleEditModel _model = new();
    private ApplicationUser? _selectedAuthor;
    private List<ArticleImageDropItem> _existingImageItems = new();
    private List<int> _removedImageIds = new();
    private List<IBrowserFile> _selectedImageFiles = new();
    private List<string> _imageUploadErrors = new();

    public async Task ShowModal(Article? existing)
    {
        _article = existing;
        _isEditMode = existing != null;
        _errorMessage = null;
        _selectedImageFiles.Clear();
        _imageUploadErrors.Clear();
        _removedImageIds.Clear();
        _existingImageItems = existing?.Images.OrderBy(i => i.DisplayOrder).Select(i => new ArticleImageDropItem { Image = i }).ToList()
            ?? new List<ArticleImageDropItem>();

        _model = existing == null
            ? new ArticleEditModel()
            : new ArticleEditModel
            {
                Title = existing.Title,
                TagLine = existing.TagLine,
                Body = existing.Body,
                Status = existing.Status,
                Audience = existing.Audience,
                MediaLayout = existing.MediaLayout,
                FeatureOnHomePage = existing.FeatureOnHomePage
            };

        if (existing != null)
        {
            _selectedAuthor = existing.Author ?? await UserManager.FindByIdAsync(existing.AuthorUserId);
        }
        else
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _selectedAuthor = await UserManager.GetUserAsync(authState.User);
        }

        _isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        _isVisible = false;
    }

    private void OnImagesSelected(InputFileChangeEventArgs e)
    {
        _imageUploadErrors.Clear();
        if (e.FileCount > 0)
        {
            _selectedImageFiles.AddRange(e.GetMultipleFiles());
            _imageUploadErrors = ImageService.ValidateImageFiles(_selectedImageFiles);
        }
        StateHasChanged();
    }

    private void RemoveExistingImage(ImageAttachment image)
    {
        _removedImageIds.Add(image.Id);
        _existingImageItems.RemoveAll(i => i.Image.Id == image.Id);
    }

    private void ExistingImageDropped(MudItemDropInfo<ArticleImageDropItem> dropItem)
    {
        if (dropItem.Item is null)
            return;

        _existingImageItems.Remove(dropItem.Item);
        var index = Math.Clamp(dropItem.IndexInZone, 0, _existingImageItems.Count);
        _existingImageItems.Insert(index, dropItem.Item);
    }

    private static string GetLayoutDescription(ArticleMediaLayout layout) => layout switch
    {
        ArticleMediaLayout.Hero => "Uses the first photo as a full-width banner above the title.",
        ArticleMediaLayout.SplitTextWrap => "Uses the first photo, floated beside the opening paragraph so text wraps around it.",
        ArticleMediaLayout.Gallery => "Uses every photo, shown in an even grid after the article body.",
        ArticleMediaLayout.Masonry => "Uses every photo, shown in a Pinterest-style staggered grid after the article body.",
        ArticleMediaLayout.Carousel => "Uses every photo, shown as a slideshow after the article body.",
        ArticleMediaLayout.InlineBreaks => "Uses every photo, woven between paragraphs as the article body reads.",
        _ => ""
    };

    private async Task<IEnumerable<ApplicationUser>> SearchAuthorsAsync(string search, CancellationToken cancellationToken)
    {
        var query = UserManager.Users.AsQueryable();
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(u =>
                (u.Email != null && u.Email.Contains(search)) ||
                (u.UserName != null && u.UserName.Contains(search)) ||
                (u.DisplayName != null && u.DisplayName.Contains(search)));
        }

        return await query.OrderBy(u => u.Email).Take(20).ToListAsync();
    }

    private async Task<string> GetCurrentUserIdAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        return user?.Id ?? string.Empty;
    }

    private async Task HandleSave()
    {
        _errorMessage = null;

        if (_selectedAuthor == null)
        {
            _errorMessage = "Please select an author.";
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            var currentUserId = await GetCurrentUserIdAsync();
            if (string.IsNullOrEmpty(currentUserId))
            {
                _errorMessage = "Unable to determine the current user. Please refresh and log in again.";
                return;
            }

            if (_isEditMode && _article != null)
            {
                _article.Title = _model.Title;
                _article.TagLine = _model.TagLine;
                _article.Body = _model.Body;
                _article.Status = _model.Status;
                _article.Audience = _model.Audience;
                _article.MediaLayout = _model.MediaLayout;
                _article.FeatureOnHomePage = _model.FeatureOnHomePage;
                _article.AuthorUserId = _selectedAuthor.Id;

                await ArticleService.UpdateAsync(_article, currentUserId);

                foreach (var imageId in _removedImageIds)
                {
                    var image = await ArticleService.GetArticleImageAsync(imageId);
                    if (image != null)
                    {
                        await ImageService.DeleteImageAsync(image);
                        await ArticleService.DeleteArticleImageAsync(imageId);
                    }
                }

                if (_existingImageItems.Any())
                {
                    await ArticleService.ReorderArticleImagesAsync(_article.Id, _existingImageItems.Select(i => i.Image.Id).ToList());
                }

                await UploadSelectedImagesAsync(_article);
            }
            else
            {
                var article = new Article
                {
                    Title = _model.Title,
                    TagLine = _model.TagLine,
                    Body = _model.Body,
                    Status = _model.Status,
                    Audience = _model.Audience,
                    MediaLayout = _model.MediaLayout,
                    FeatureOnHomePage = _model.FeatureOnHomePage,
                    AuthorUserId = _selectedAuthor.Id
                };

                article = await ArticleService.CreateAsync(article, currentUserId);
                await UploadSelectedImagesAsync(article);
            }

            _isVisible = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error saving article: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task UploadSelectedImagesAsync(Article article)
    {
        if (!_selectedImageFiles.Any())
        {
            return;
        }

        var hasExistingImages = _existingImageItems.Any();
        for (var i = 0; i < _selectedImageFiles.Count; i++)
        {
            var result = await ImageService.SaveImageAsync(_selectedImageFiles[i], article.ImageSubfolder);
            if (result.Success)
            {
                await ArticleService.AddArticleImageAsync(article.Id, result, isMainImage: !hasExistingImages && i == 0);
            }
        }
    }

    public class ArticleEditModel
    {
        [Required(ErrorMessage = "Title is required")]
        [StringLength(200)]
        public string Title { get; set; } = "";

        [StringLength(300)]
        public string? TagLine { get; set; }

        [Required(ErrorMessage = "Body is required")]
        public string Body { get; set; } = "";

        public ArticleStatus Status { get; set; } = ArticleStatus.Draft;
        public ArticleAudience Audience { get; set; } = ArticleAudience.Public;
        public ArticleMediaLayout MediaLayout { get; set; } = ArticleMediaLayout.Hero;
        public bool FeatureOnHomePage { get; set; }
    }

    public class ArticleImageDropItem
    {
        public ImageAttachment Image { get; set; } = default!;
    }
}
