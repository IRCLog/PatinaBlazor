@page "/admin/allUsers"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using PatinaBlazor.Data
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject UserManager<ApplicationUser> UserManager

<PageTitle>All Users - Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4">All Users</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Href="/admin">Back to Admin</MudButton>
    </div>

    @if (users == null)
    {
        <div class="text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body1" Class="mt-2">Loading users...</MudText>
        </div>
    }
    else
    {
        <MudGrid Class="mb-3" AlignItems="AlignItems.Center">
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              Value="_searchText"
                              ValueChanged="@((string v) => _searchText = v)"
                              Immediate="true"
                              Placeholder="Search by name or email..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="6" Style="text-align: right;">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Showing @FilteredUsers.Count() of @users.Count users
                </MudText>
            </MudItem>
        </MudGrid>

        <MudGrid>
            @foreach (var user in FilteredUsers)
            {
                <MudItem xs="12" sm="6" md="4" lg="4">
                    <MudCard Elevation="2" Style="height: 100%; display: flex; flex-direction: column;">
                        <MudCardHeader Class="user-card-header">
                            <CardHeaderAvatar>
                                @if (IsAdmin(user))
                                {
                                    <MudTooltip Text="Admin">
                                        <MudBadge Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Warning" Origin="Origin.TopLeft" Overlap="true">
                                            <MudAvatar Color="Color.Primary">@GetInitial(user)</MudAvatar>
                                        </MudBadge>
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudAvatar Color="Color.Primary">@GetInitial(user)</MudAvatar>
                                }
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <div style="min-width: 0;">
                                    <MudText Typo="Typo.subtitle1" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@user.UserName</MudText>
                                    @if (!string.IsNullOrWhiteSpace(user.DisplayName))
                                    {
                                        <MudText Typo="Typo.body2" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@user.DisplayName</MudText>
                                    }
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@user.Email</MudText>
                                </div>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudTooltip Text="Edit">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => _editDialog!.ShowModal(user))" />
                                </MudTooltip>
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => PromptDelete(user))" />
                                </MudTooltip>
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent Class="flex-grow-1 user-card-content">
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                                <MudChip T="string" Size="Size.Small" Color="@(user.IsLocked ? Color.Error : Color.Success)">@(user.IsLocked ? "Locked" : "Unlocked")</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="@(user.EmailConfirmed ? Color.Success : Color.Warning)">@(user.EmailConfirmed ? "Confirmed" : "Pending")</MudChip>
                            </MudStack>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                Created @user.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <MudAlert Severity="@(isError ? Severity.Error : Severity.Success)" ShowCloseIcon="true" CloseIconClicked="ClearMessage" Class="mt-3">@message</MudAlert>
    }
</MudContainer>

<EditUserDialog @ref="_editDialog" OnSaved="HandleUserSaved" />
<ConfirmDialog @ref="_confirmDialog" OnConfirmed="HandleDeleteConfirmed" />

@code {
    private List<ApplicationUser> users = null!;
    private Dictionary<string, List<string>> userRoles = new();
    private string _searchText = "";
    private string message = "";
    private bool isError = false;
    private EditUserDialog? _editDialog;
    private ConfirmDialog? _confirmDialog;
    private ApplicationUser? _userPendingDelete;

    private IEnumerable<ApplicationUser> FilteredUsers =>
        string.IsNullOrWhiteSpace(_searchText)
            ? users
            : users.Where(u =>
                (u.DisplayName?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.UserName?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.Email?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        users = UserManager.Users.ToList();
        userRoles.Clear();

        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);
            userRoles[user.Id] = roles.ToList();
        }
    }

    private async Task HandleUserSaved()
    {
        await LoadUsers();
        ShowMessage("User updated successfully.", false);
    }

    private static string GetDisplayName(ApplicationUser user) =>
        !string.IsNullOrWhiteSpace(user.DisplayName) ? user.DisplayName! : (user.UserName ?? user.Email ?? "");

    private static string GetInitial(ApplicationUser user)
    {
        var name = GetDisplayName(user);
        return name.Length > 0 ? name[..1].ToUpperInvariant() : "?";
    }

    private bool IsAdmin(ApplicationUser user) =>
        userRoles.TryGetValue(user.Id, out var roles) && roles.Contains("Admin", StringComparer.OrdinalIgnoreCase);

    private Task PromptDelete(ApplicationUser user)
    {
        _userPendingDelete = user;
        return _confirmDialog!.ShowModal(
            "Delete User",
            $"Are you sure you want to delete {GetDisplayName(user)} ({user.Email})? This will also permanently delete all of their collections and collectables. This cannot be undone.",
            "Delete",
            Color.Error);
    }

    private async Task HandleDeleteConfirmed()
    {
        if (_userPendingDelete == null)
            return;

        var email = _userPendingDelete.Email;
        var result = await UserManager.DeleteAsync(_userPendingDelete);
        _userPendingDelete = null;

        if (result.Succeeded)
        {
            await LoadUsers();
            ShowMessage($"User {email} deleted successfully", false);
        }
        else
        {
            ShowMessage("Error deleting user: " + string.Join(", ", result.Errors.Select(e => e.Description)), true);
        }
    }

    private void ShowMessage(string msg, bool error)
    {
        message = msg;
        isError = error;
        StateHasChanged();
    }

    private void ClearMessage()
    {
        message = "";
    }
}
