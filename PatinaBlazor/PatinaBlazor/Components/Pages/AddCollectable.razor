@page "/add-collectable"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using PatinaBlazor.Data
@using PatinaBlazor.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@rendermode InteractiveServer
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IImageService ImageService
@inject ICollectionService CollectionService
@inject ISnackbar Snackbar

<ImageModal @ref="imageModal" Description="@newCollectable.Description" ShowImageInfo="false" />

<PageTitle>Add New Collectable</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4">
            <MudIcon Icon="@Icons.Material.Filled.AddCircle" Class="mr-2" /> Add New Collectable
        </MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.List" Href="/my-collectables">My Collectables</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/collectables">Back to Collectables</MudButton>
        </MudStack>
    </div>

    <MudPaper Elevation="2" Class="pa-4">
        <EditForm Model="@newCollectable" OnValidSubmit="@HandleValidSubmit" FormName="AddCollectableForm">
            <DataAnnotationsValidator />

            <MudTabs Rounded="true" Color="Color.Primary" Class="mb-4">
                <MudTabPanel Text="General Information" Icon="@Icons.Material.Filled.Info">
                    <MudTextField Label="Description" Required="true" @bind-Value="newCollectable.Description" For="@(() => newCollectable.Description)" Placeholder="Enter description of your collectable" Class="mb-4" />
                    <MudNumericField Label="Price Paid (USD)" Required="true" @bind-Value="newCollectable.PricePaid" For="@(() => newCollectable.PricePaid)" Format="F2" Adornment="Adornment.Start" AdornmentText="$" Class="mb-4" />
                    <MudDatePicker Label="Date Acquired" @bind-Date="newCollectable.DateAcquired" For="@(() => newCollectable.DateAcquired)" Class="mb-4" />
                    <MudTextField Label="Acquired From" @bind-Value="newCollectable.AcquiredFrom" For="@(() => newCollectable.AcquiredFrom)" Placeholder="Where or who did you acquire this from?" Class="mb-4" />
                    <MudTextField Label="Notes" @bind-Value="newCollectable.Notes" For="@(() => newCollectable.Notes)" Placeholder="Add any additional notes about this collectable (optional)" Lines="4" Class="mb-4" />
                </MudTabPanel>

                <MudTabPanel Text="Sale Information" Icon="@Icons.Material.Filled.AttachMoney">
                    <MudSwitch T="bool" @bind-Value="newCollectable.IsForSale" Label="This item is for sale" Color="Color.Primary" Class="mb-3" />

                    @if (newCollectable.IsForSale)
                    {
                        <MudNumericField Label="Asking Price (USD)" @bind-Value="newCollectable.AskingPrice" For="@(() => newCollectable.AskingPrice)" Format="F2" Adornment="Adornment.Start" AdornmentText="$" Class="mb-4" />
                    }

                    <MudSwitch T="bool" @bind-Value="newCollectable.IsSold" Label="This item has been sold" Color="Color.Primary" Class="mb-3" />

                    @if (newCollectable.IsSold)
                    {
                        <MudNumericField Label="Sale Price (USD)" @bind-Value="newCollectable.SalePrice" For="@(() => newCollectable.SalePrice)" Format="F2" Adornment="Adornment.Start" AdornmentText="$" Class="mb-4" />
                        <MudDatePicker Label="Date Sold" @bind-Date="newCollectable.DateSold" For="@(() => newCollectable.DateSold)" Class="mb-4" />
                        <MudTextField Label="Sold To" @bind-Value="newCollectable.SoldTo" For="@(() => newCollectable.SoldTo)" Placeholder="Who did you sell this to?" Class="mb-4" />
                    }
                </MudTabPanel>

                <MudTabPanel Text="Images" Icon="@Icons.Material.Filled.Image">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Images</MudText>
                    <InputFile @ref="imagesInput" id="images" OnChange="OnImagesSelected" accept="image/*" multiple class="mud-input-file" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 mb-3" Style="display: block;">
                        Upload up to 10 images for your collectable (max 15MB each). Supported formats: JPG, PNG, GIF, WebP. Large images will be automatically compressed to improve upload speed. The first image will be set as the main image.
                    </MudText>

                    @if (imageUploadErrors.Any())
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2">
                            Image Upload Errors:
                            <ul class="mb-0 mt-2">
                                @foreach (var error in imageUploadErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </MudAlert>
                    }

                    @if (selectedImageFiles.Any())
                    {
                        <div class="mt-3">
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle1">
                                    <MudIcon Icon="@Icons.Material.Filled.Image" Class="mr-1" /> Selected Images (@selectedImageFiles.Count)
                                </MudText>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel" OnClick="@(async () => await ClearSelectedImages())">Clear All</MudButton>
                            </div>
                            <MudGrid>
                                @for (int i = 0; i < selectedImageFiles.Count; i++)
                                {
                                    var index = i;
                                    var file = selectedImageFiles[i];
                                    <MudItem xs="12" md="6" lg="4">
                                        <MudCard>
                                            @if (index < imagePreviewUrls.Count)
                                            {
                                                <div style="height: 200px; overflow: hidden; display: flex; align-items: center; justify-content: center; background-color: var(--bg-tertiary);">
                                                    <img src="@imagePreviewUrls[index]"
                                                         alt="@file.Name"
                                                         style="max-height: 100%; max-width: 100%; object-fit: contain; cursor: pointer;"
                                                         @onclick="(() => ShowSelectedImageModal(index))" />
                                                </div>
                                            }
                                            <MudCardContent>
                                                @if (index == 0)
                                                {
                                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mb-2">Main Image</MudChip>
                                                }
                                                <MudText Typo="Typo.subtitle2" Style="cursor: pointer;" @onclick="(() => ShowSelectedImageModal(index))">@file.Name</MudText>
                                                <MudText Typo="Typo.body2">Size: @FormatFileSize(file.Size)</MudText>
                                                <MudText Typo="Typo.body2" Class="mb-2">Type: @file.ContentType</MudText>
                                                <MudStack Row="true" Spacing="2">
                                                    @if (index > 0)
                                                    {
                                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Star" OnClick="(() => MoveImageToMain(index))">Set as Main</MudButton>
                                                    }
                                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel" OnClick="@(async () => await RemoveSelectedImage(index))">Remove</MudButton>
                                                </MudStack>
                                            </MudCardContent>
                                        </MudCard>
                                    </MudItem>
                                }
                            </MudGrid>
                        </div>
                    }
                </MudTabPanel>
            </MudTabs>

            <div class="d-flex justify-end" style="gap: 0.5rem;">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Cancel" OnClick="@(async () => await ResetForm())">Clear</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="@isSubmitting" StartIcon="@Icons.Material.Filled.Save">
                    @if (isSubmitting)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    }
                    Save Collectable
                </MudButton>
            </div>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private CollectableFormModel newCollectable = new();
    private string currentUserId = string.Empty;
    private bool isSubmitting = false;
    private List<IBrowserFile> selectedImageFiles = new();
    private InputFile? imagesInput;
    private List<string> imageUploadErrors = new();
    private ImageModal imageModal = default!;
    private List<string> imagePreviewUrls = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            currentUserId = user.Id;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (string.IsNullOrEmpty(currentUserId))
        {
            Snackbar.Add("User not found. Please log in again.", Severity.Error);
            return;
        }

        isSubmitting = true;
        StateHasChanged();

        try
        {
            var collectable = new Collectable
            {
                Description = newCollectable.Description,
                PricePaid = newCollectable.PricePaid,
                AskingPrice = newCollectable.AskingPrice,
                DateAcquired = newCollectable.DateAcquired,
                AcquiredFrom = newCollectable.AcquiredFrom,
                IsForSale = newCollectable.IsForSale,
                IsSold = newCollectable.IsSold,
                DateSold = newCollectable.DateSold,
                SoldTo = newCollectable.SoldTo,
                SalePrice = newCollectable.SalePrice,
                Notes = newCollectable.Notes,
                UserId = currentUserId,
                CreatedDate = DateTime.UtcNow
            };

            // Save collectable first to get ID
            DbContext.Collectables.Add(collectable);
            await DbContext.SaveChangesAsync();

            // Handle multiple image uploads if present
            if (selectedImageFiles.Any())
            {
                var uploadResults = await ImageService.SaveMultipleImagesAsync(selectedImageFiles, collectable.ImageSubfolder);

                var successfulUploads = uploadResults.Where(r => r.Success).ToList();
                var failedUploads = uploadResults.Where(r => !r.Success).ToList();

                if (failedUploads.Any())
                {
                    var errorMessage = string.Join(", ", failedUploads.Select(f => f.ErrorMessage));
                    Snackbar.Add($"Failed to upload some images: {errorMessage}", Severity.Error);

                    // Clean up successful uploads if any failed
                    foreach (var successResult in successfulUploads)
                    {
                        await ImageService.DeleteImageAsync(successResult);
                    }
                    return;
                }

                // Create ImageAttachment records for successful uploads
                for (int i = 0; i < successfulUploads.Count; i++)
                {
                    var result = successfulUploads[i];
                    var collectableImage = new ImageAttachment
                    {
                        CollectableId = collectable.Id,
                        FileName = result.FileName,
                        RelativePath = result.RelativePath,
                        ThumbnailRelativePath = result.ThumbnailRelativePath,
                        MediumRelativePath = result.MediumRelativePath,
                        ContentType = result.ContentType,
                        FileSize = result.FileSize,
                        IsMainImage = i == 0, // First image is main
                        DisplayOrder = i,
                        CreatedDate = DateTime.UtcNow
                    };

                    DbContext.ImageAttachments.Add(collectableImage);
                }

                await DbContext.SaveChangesAsync();
            }

            // Add collectable to "All Collectables" system collection
            var allCollectablesCollection = await CollectionService.GetAllCollectablesCollectionAsync(currentUserId);
            if (allCollectablesCollection != null)
            {
                await CollectionService.AddCollectableToCollectionAsync(allCollectablesCollection.Id, collectable.Id);
            }

            Snackbar.Add($"Successfully added '{collectable.Description}' to your collection!", Severity.Success, config =>
            {
                config.Action = "View My Collectables";
                config.ActionColor = Color.Inherit;
                config.Onclick = snackbar =>
                {
                    Navigation.NavigateTo("/my-collectables");
                    return Task.CompletedTask;
                };
            });

            // Reset form
            newCollectable = new CollectableFormModel();
            await ClearSelectedImages();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save collectable: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task ResetForm()
    {
        newCollectable = new CollectableFormModel();
        await ClearSelectedImages();
    }

    private async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        selectedImageFiles.Clear();
        imageUploadErrors.Clear();
        await ClearImagePreviewUrls();

        if (e.FileCount > 0)
        {
            selectedImageFiles.AddRange(e.GetMultipleFiles());
            imageUploadErrors = ImageService.ValidateImageFiles(selectedImageFiles);
            await CreateImagePreviewUrls();
        }

        StateHasChanged();
    }

    private async Task ClearSelectedImages()
    {
        selectedImageFiles.Clear();
        imageUploadErrors.Clear();
        await ClearImagePreviewUrls();
        StateHasChanged();
    }

    private async Task RemoveSelectedImage(int index)
    {
        if (index >= 0 && index < selectedImageFiles.Count)
        {
            // Revoke the URL for the removed image
            if (index < imagePreviewUrls.Count)
            {
                await JSRuntime.InvokeVoidAsync("URL.revokeObjectURL", imagePreviewUrls[index]);
                imagePreviewUrls.RemoveAt(index);
            }

            selectedImageFiles.RemoveAt(index);
            imageUploadErrors = ImageService.ValidateImageFiles(selectedImageFiles);
            StateHasChanged();
        }
    }

    private void MoveImageToMain(int index)
    {
        if (index > 0 && index < selectedImageFiles.Count && index < imagePreviewUrls.Count)
        {
            var imageToMove = selectedImageFiles[index];
            var urlToMove = imagePreviewUrls[index];

            selectedImageFiles.RemoveAt(index);
            selectedImageFiles.Insert(0, imageToMove);

            imagePreviewUrls.RemoveAt(index);
            imagePreviewUrls.Insert(0, urlToMove);

            StateHasChanged();
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB" };
        int counter = 0;
        decimal number = bytes;

        while (Math.Round(number / 1024) >= 1)
        {
            number /= 1024;
            counter++;
        }

        return $"{number:n1}{suffixes[counter]}";
    }

    private async Task CreateImagePreviewUrls()
    {
        await ClearImagePreviewUrls();

        // Passing an IBrowserFile itself through JS interop only serializes its metadata, not a
        // real File/Blob - URL.createObjectURL needs the actual browser File object, which is only
        // reachable via the underlying <input> element's own .files list, indexed the same way
        // selectedImageFiles was just built from e.GetMultipleFiles() a moment ago in OnImagesSelected.
        if (imagesInput?.Element is { } inputElement)
        {
            for (var i = 0; i < selectedImageFiles.Count; i++)
            {
                var url = await JSRuntime.InvokeAsync<string>("createObjectURLFromInput", inputElement, i);
                imagePreviewUrls.Add(url);
            }
        }
    }

    private async Task ClearImagePreviewUrls()
    {
        foreach (var url in imagePreviewUrls)
        {
            await JSRuntime.InvokeVoidAsync("URL.revokeObjectURL", url);
        }
        imagePreviewUrls.Clear();
    }

    private async Task ShowSelectedImageModal(int index)
    {
        if (imagePreviewUrls.Count > index)
        {
            await imageModal.ShowModal(imagePreviewUrls, index);
        }
    }

    public class CollectableFormModel
    {
        [Required(ErrorMessage = "Description is required")]
        [StringLength(500, ErrorMessage = "Description cannot exceed 500 characters")]
        public string Description { get; set; } = string.Empty;

        [Required(ErrorMessage = "Price paid is required")]
        [Range(0.01, double.MaxValue, ErrorMessage = "Price paid must be greater than $0.00")]
        public decimal PricePaid { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "Asking price must be a positive value")]
        public decimal? AskingPrice { get; set; }

        public DateTime? DateAcquired { get; set; }

        [StringLength(200, ErrorMessage = "Acquired from cannot exceed 200 characters")]
        public string? AcquiredFrom { get; set; }

        public bool IsForSale { get; set; } = false;

        public bool IsSold { get; set; } = false;

        public DateTime? DateSold { get; set; }

        [StringLength(200, ErrorMessage = "Sold to cannot exceed 200 characters")]
        public string? SoldTo { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "Sale price must be a positive value")]
        public decimal? SalePrice { get; set; }

        [StringLength(1000, ErrorMessage = "Notes cannot exceed 1000 characters")]
        public string? Notes { get; set; }
    }
}

<script>
    window.createObjectURLFromInput = (inputElement, index) => {
        return URL.createObjectURL(inputElement.files[index]);
    };
</script>
