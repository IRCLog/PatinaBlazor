@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using PatinaBlazor.Data
@using PatinaBlazor.Services
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager

<PageTitle>Register</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-4">
    <MudGrid Justify="Justify.Center">
        <MudItem xs="12" sm="8" md="6">
            <MudPaper Elevation="2" Class="pa-4">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
                }
                <EditForm Model="_input" FormName="register" OnValidSubmit="RegisterUser">
                    <DataAnnotationsValidator />
                    <MudText Typo="Typo.h5" Class="text-center mb-4">Create New Account</MudText>
                    <MudTextField Label="Email" Placeholder="name@example.com" @bind-Value="_input.Email" For="@(() => _input.Email)" Class="mb-3" />
                    <MudTextField Label="Display Name" Placeholder="YourDisplayName" @bind-Value="_input.DisplayName" For="@(() => _input.DisplayName)" Class="mb-3" />
                    <MudTextField Label="Password" Placeholder="password" InputType="InputType.Password" @bind-Value="_input.Password" For="@(() => _input.Password)" Class="mb-3" />
                    <MudTextField Label="Confirm Password" Placeholder="confirm password" InputType="InputType.Password" @bind-Value="_input.ConfirmPassword" For="@(() => _input.ConfirmPassword)" Class="mb-4" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Class="mb-3" Disabled="_submitting">Register</MudButton>
                    <div class="text-center">
                        <p class="mb-0">
                            Already have an account? <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Login", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">Sign in</a>
                        </p>
                    </div>
                </EditForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private readonly InputModel _input = new();
    private string? _errorMessage;
    private bool _submitting;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    public async Task RegisterUser()
    {
        _submitting = true;
        _errorMessage = null;

        var displayNameTaken = await UserManager.Users
            .AnyAsync(u => u.DisplayName == _input.DisplayName);
        if (displayNameTaken)
        {
            _errorMessage = "Display name is already taken.";
            _submitting = false;
            return;
        }

        var user = new ApplicationUser
        {
            UserName = _input.Email,
            Email = _input.Email,
            DisplayName = _input.DisplayName,
            CreatedDate = DateTime.UtcNow
        };

        var result = await UserManager.CreateAsync(user, _input.Password);
        if (!result.Succeeded)
        {
            _errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            _submitting = false;
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogSecurityInformation("User {Email} ({UserId}) registered a new account.", _input.Email, userId);

        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code, ["returnUrl"] = ReturnUrl });

        await EmailSender.SendConfirmationLinkAsync(user, _input.Email, callbackUrl);

        // UserManager.Options.SignIn.RequireConfirmedAccount is true app-wide (Program.cs), so
        // the immediate-sign-in path the stock scaffolded template also supports is dead code
        // here in practice - and couldn't work from this interactive render mode anyway, since
        // setting the auth cookie requires a real HTTP response (see Login.razor, which stays
        // static SSR for exactly this reason). If RequireConfirmedAccount is ever turned off,
        // this page would need to move back to that pattern to support immediate sign-in.
        //
        // forceLoad: true - RegisterConfirmation.razor is a static-SSR page (needs a real
        // HttpContext) - a plain in-circuit NavigateTo from this interactive page would try to
        // render it inside the wrong render-mode boundary.
        var confirmationUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/RegisterConfirmation").AbsoluteUri,
            new Dictionary<string, object?> { ["email"] = _input.Email, ["returnUrl"] = ReturnUrl });
        NavigationManager.NavigateTo(confirmationUrl, forceLoad: true);
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        [Display(Name = "Email")]
        public string Email { get; set; } = "";

        [Required]
        [StringLength(50, ErrorMessage = "Display name must be between 3 and 50 characters.", MinimumLength = 3)]
        [RegularExpression(@"^[a-zA-Z0-9_\-]+$", ErrorMessage = "Display name may only contain letters, numbers, underscores, and hyphens.")]
        [Display(Name = "Display Name")]
        public string DisplayName { get; set; } = "";

        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
