        <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" /> Account Settings
    </MudText>
    <MudGrid Spacing="3">
        <MudItem xs="12" md="3">
            <ManageNavMenu />
        </MudItem>
        <MudItem xs="12" md="9">
            @Body
        </MudItem>
    </MudGrid>
</MudContainer>
