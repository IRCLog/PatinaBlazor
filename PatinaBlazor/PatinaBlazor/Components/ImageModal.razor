@using PatinaBlazor.Data

<MudDialog @bind-IsVisible="isVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Image @(currentIndex + 1) of @imageCount</MudText>
    </TitleContent>
    <DialogContent>
        @if (currentImage != null)
        {
            <div class="d-flex align-center justify-center position-relative" style="min-height: 400px;">
                <img src="@GetImageSource()"
                     alt="@(Description ?? "Image")"
                     style="max-height: 80vh; max-width: 100%; object-fit: contain;" />

                @if (imageCount > 1)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                   Color="Color.Inherit"
                                   Class="position-absolute"
                                   Style="left: 8px; top: 50%; transform: translateY(-50%);"
                                   OnClick="PreviousImage" />

                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                   Color="Color.Inherit"
                                   Class="position-absolute"
                                   Style="right: 8px; top: 50%; transform: translateY(-50%);"
                                   OnClick="NextImage" />
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (currentImage != null && ShowImageInfo && currentImage is ImageAttachment imageAttachment)
        {
            <MudText Typo="Typo.caption">Size: @FormatFileSize(imageAttachment.FileSize)</MudText>
            <MudText Typo="Typo.caption" Class="ml-3">Type: @imageAttachment.ContentType</MudText>
            @if (imageAttachment.IsMainImage)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-3">Main Image</MudChip>
            }
        }
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool ShowImageInfo { get; set; } = true;
    [Parameter] public string? Description { get; set; }

    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.ExtraLarge,
        FullWidth = true,
        CloseOnEscapeKey = true,
    };

    private List<object> images = new();
    private object? currentImage;
    private int currentIndex = 0;
    private int imageCount => images.Count;
    private bool isVisible = false;

    public async Task ShowModal(List<ImageAttachment> imageAttachments, int startIndex = 0)
    {
        images = imageAttachments.Cast<object>().ToList();
        currentIndex = Math.Max(0, Math.Min(startIndex, images.Count - 1));
        currentImage = images.Count > 0 ? images[currentIndex] : null;
        isVisible = true;
        StateHasChanged();
        await Task.CompletedTask;
    }

    public async Task ShowModal(List<string> imageUrls, int startIndex = 0)
    {
        images = imageUrls.Cast<object>().ToList();
        currentIndex = Math.Max(0, Math.Min(startIndex, images.Count - 1));
        currentImage = images.Count > 0 ? images[currentIndex] : null;
        isVisible = true;
        StateHasChanged();
        await Task.CompletedTask;
    }

    private void NextImage()
    {
        if (images.Count > 1)
        {
            currentIndex = (currentIndex + 1) % images.Count;
            currentImage = images[currentIndex];
            StateHasChanged();
        }
    }

    private void PreviousImage()
    {
        if (images.Count > 1)
        {
            currentIndex = currentIndex == 0 ? images.Count - 1 : currentIndex - 1;
            currentImage = images[currentIndex];
            StateHasChanged();
        }
    }

    private string GetImageSource()
    {
        return currentImage switch
        {
            ImageAttachment imageAttachment => imageAttachment.RelativePath,
            string imageUrl => imageUrl,
            _ => string.Empty
        };
    }

    private string FormatFileSize(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB" };
        int counter = 0;
        decimal number = bytes;

        while (Math.Round(number / 1024) >= 1)
        {
            number /= 1024;
            counter++;
        }

        return $"{number:n1}{suffixes[counter]}";
    }
}
