@* Table-cell button, not a styled <a> - a plain anchor with padding/background renders
   inconsistently across email clients, but a table cell with a solid background reliably
   looks like a button everywhere that matters for this app's audience (this deliberately
   skips the VML/Outlook-desktop conditional-comment fallback real marketing-email tooling
   uses; not worth the complexity for a personal app's account emails). *@
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0;">
    <tr>
        <td style="border-radius:6px; background-color:#1f6feb;">
            <a href="@Href" target="_blank" rel="noopener noreferrer"
               style="display:inline-block; padding:12px 28px; color:#ffffff; font-size:15px; font-weight:600; text-decoration:none; border-radius:6px;">
                @ChildContent
            </a>
        </td>
    </tr>
</table>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
