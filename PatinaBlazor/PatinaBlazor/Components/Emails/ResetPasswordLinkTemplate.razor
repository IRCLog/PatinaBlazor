<EmailLayout Title="Reset your password">
    <p style="margin:0 0 16px 0; font-size:18px; font-weight:700;">Password Reset Request</p>
    <p style="margin:0 0 8px 0;">We received a request to reset your password. Click the button below to choose a new one.</p>
    <EmailButton Href="@ResetLink">Reset Password</EmailButton>
    <p style="margin:16px 0 0 0; color:#8a8f98; font-size:13px;">If you didn't request a password reset, you can safely ignore this email - your password won't be changed.</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string ResetLink { get; set; } = "";
}
