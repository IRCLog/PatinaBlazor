<EmailLayout Title="Reset your password" PreheaderText="@($"Your password reset code is {ResetCode}")">
    <p style="margin:0 0 16px 0; font-size:18px; font-weight:700;">Password Reset Code</p>
    <p style="margin:0 0 8px 0;">Use the code below to reset your password.</p>
    <div style="margin:24px 0; padding:16px; background-color:#f4f4f7; border-radius:6px; text-align:center; font-size:28px; font-weight:700; letter-spacing:4px; color:#1f6feb;">
        @ResetCode
    </div>
    <p style="margin:16px 0 0 0; color:#8a8f98; font-size:13px;">If you didn't request a password reset, you can safely ignore this email - your password won't be changed.</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string ResetCode { get; set; } = "";
}
